PORT=3000

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=progress
DB_PASSWORD=progress
DB_DATABASE=progress_meter

# Keep false until the project has formal migrations.
DB_SYNCHRONIZE=false

# Use a long, unique random value in every non-local environment.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
