# Copy to .env in this directory. Never commit .env or put this key in Flutter.
OPENAI_API_KEY=
# Use a model enabled for your OpenAI project that supports Structured Outputs.
OPENAI_MODEL=gpt-6-luna
COACH_MODE=live
HOST=127.0.0.1
PORT=8787

# Optional for a local backend; REQUIRED before binding to a non-loopback host.
# The Flutter client can supply the same gateway token, never the OpenAI key.
COACH_ACCESS_TOKEN=
# Explicitly permit one browser origin only if you later add web support.
# Native Flutter requests have no Origin header and do not need this setting.
COACH_ALLOWED_ORIGIN=
